<!DOCTYPE html>
<html>
<head>
    <title>Edit Expense</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>

<div class="container mt-5">

    <h1>Edit Expense</h1>

    <form action="/edit/<%= id %>" method="POST">

        <div class="mb-3">

            <label class="form-label">
                Expense Name
            </label>

            <input
                type="text"
                name="name"
                value="<%= expense.name %>"
                class="form-control"
                required>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Amount
            </label>

            <input
                type="number"
                name="amount"
                value="<%= expense.amount %>"
                class="form-control"
                required>

        </div>

        <div class="mb-3">

            <label class="form-label">
                Category
            </label>

            <select
                name="category"
                class="form-select">

                <option <%= expense.category==="Food"?"selected":"" %>>
                    Food
                </option>

                <option <%= expense.category==="Transport"?"selected":"" %>>
                    Transport
                </option>

                <option <%= expense.category==="Shopping"?"selected":"" %>>
                    Shopping
                </option>

                <option <%= expense.category==="Other"?"selected":"" %>>
                    Other
                </option>

            </select>

        </div>

        <button class="btn btn-primary">
            Update Expense
        </button>

        <a href="/expenses" class="btn btn-secondary">
            Back
        </a>

    </form>

</div>

</body>
</html>
